# =============================================================================
# Shop33 — FRONTEND environment (repo root). Copy to `.env`:  cp .env.example .env
# Vite bakes VITE_* values into the bundle at build time — NEVER put secrets here
# (only public keys). Restart `npm run dev` / rebuild after changes.
# =============================================================================

# --- Backend API (required for login, admin, orders, payments) ---
# Local dev: leave empty (Vite dev uses http://127.0.0.1:4242) or set explicitly.
# Production (GitHub Pages): https://your-api.onrender.com  (no trailing slash)
VITE_API_BASE_URL=
# Rare: separate payment API origin (defaults to VITE_API_BASE_URL)
# VITE_PAYMENT_API_URL=http://127.0.0.1:4242

# --- Stripe (card payments) — use TEST keys (pk_test_...) until go-live ---
VITE_STRIPE_CHECKOUT_ENABLED=false
VITE_STRIPE_PUBLISHABLE_KEY=

# --- LiqPay (Ukrainian payments) — server keys live in server/.env ---
VITE_LIQPAY_ENABLED=false

# --- EmailJS (optional: registration / order confirmation emails) ---
# https://www.emailjs.com/ — template "To Email" must be {{user_email}}.
# Template vars: {{email_intro}}, {{thank_you_text}}, {{user_name}}, {{email_subject}},
# order template may also use {{order_id}}, {{order_summary}}, {{payment_label}}.
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
# VITE_EMAILJS_TEMPLATE_ORDER_ID=
