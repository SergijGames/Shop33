# =============================================================================
# Shop33 — BACKEND environment (server/). Copy to `server/.env`:
#   cp server/env.example server/.env
# Never commit server/.env. On Render set these in the dashboard.
# =============================================================================

# --- Server ---
PORT=4242

# --- Postgres (required for users / admin / orders / catalog API) ---
# Local Docker (server/docker-compose.yml, started by `npm run setup:local`):
DATABASE_URL="postgresql://shop33:shop33@127.0.0.1:5432/shop33?schema=public"

# --- Auth (required) — any long random string, e.g. `openssl rand -hex 32` ---
JWT_SECRET=""

# --- Admin account created on first start / by `npm run seed` (required for admin panel) ---
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Administrator"

# --- Stripe (optional) — use sk_test_... keys for testing ---
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# Optional Stripe Connect: route payments to a connected account (acct_...)
# STRIPE_CONNECTED_ACCOUNT_ID=

# --- LiqPay (optional) — sandbox keys from the LiqPay cabinet ---
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
